# ===== REQUIRED =====
# Get this from https://console.groq.com/keys  (free, no card required)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Get this from @BotFather on Telegram (see README for steps)
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxx

# ===== OPTIONAL =====
# Default model used by agents
DEFAULT_MODEL=llama-3.3-70b-versatile

# SQLite path (relative to project root)
DATABASE_URL=sqlite:///./data/platform.db

# Server
HOST=0.0.0.0
PORT=8000
